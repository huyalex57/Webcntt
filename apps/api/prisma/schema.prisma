generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  LECTURER
  MODERATOR
  ADMIN
}

enum PlanTier {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

enum ResourceStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum ResourceType {
  SLIDE
  TEXTBOOK
  EXAM
  EXERCISE
  CHEATSHEET
  VIDEO
  SOURCE
}

enum ResourceTopic {
  CTDL
  OOP
  CSDL
  MANG
  HDH
  AI_DS
  WEB_CLOUD
}

enum ResourceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ResourceSource {
  OFFICIAL
  COMMUNITY
  LECTURER
}

enum ReportReason {
  BAN_QUYEN
  SAI_LECH
  DOC_HAI
  KHONG_PHU_HOP
  SPAM
  KHAC
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum RunStatus {
  AC
  WA
  TLE
  MLE
  RE
  CE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  displayName   String
  role          Role      @default(STUDENT)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile           Profile?
  subscription      Subscription?
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]       @relation("UserAuditLogs")
  authoredResources Resource[]       @relation("ResourceAuthor")
  reviewedResources Resource[]       @relation("ResourceReviewer")
  collections       Collection[]
  reports           Report[]         @relation("ReportReporter")
  resolvedReports   Report[]         @relation("ReportResolver")
  resourceReviews   ResourceReview[]
  codeSnippets      CodeSnippet[]
  runLogs           RunLog[]
  enrollments       Enrollment[]
  learningPaths     LearningPath[]
  skillProfiles     SkillProfile[]
  aiUsages          AiUsage[]
  milestoneAttempts MilestoneAttempt[]

  @@map("users")
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  studentId   String?
  university  String?
  major       String?
  avatarUrl   String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String             @unique
  tier      PlanTier           @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  expiresAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User?    @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

// ==========================================
// Phase 1 - Module Resources (Issue #34)
// ==========================================

model Resource {
  id              String         @id @default(cuid())
  title           String
  description     String
  topic           ResourceTopic
  level           ResourceLevel  @default(INTERMEDIATE)
  format          String         @default("PDF")
  type            ResourceType
  language        String         @default("Tiếng Việt")
  sourceType      ResourceSource @default(COMMUNITY)
  url             String?
  fileKey         String?
  fileSize        Int            @default(0)
  fileSizeLabel   String?
  fileHash        String?        @unique
  status          ResourceStatus @default(PENDING)
  rejectionReason String?
  downloads       Int            @default(0)
  rating          Float          @default(0)
  ratingCount     Int            @default(0)
  authorName      String?
  authorId        String
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  author      User             @relation("ResourceAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reviewedBy  User?            @relation("ResourceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  tags        ResourceTag[]
  collections Collection[]
  reports     Report[]
  reviews     ResourceReview[]

  @@index([status, createdAt])
  @@index([topic])
  @@index([type])
  @@index([sourceType])
  @@index([url])
  @@index([authorId])
  @@map("resources")
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  slug      String        @unique
  createdAt DateTime      @default(now())

  resources ResourceTag[]

  @@map("tags")
}

model ResourceTag {
  resourceId String
  tagId      String

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([resourceId, tagId])
  @@index([tagId])
  @@map("resource_tags")
}

model Collection {
  id         String   @id @default(cuid())
  userId     String
  resourceId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId])
  @@map("collections")
}

model Report {
  id           String       @id @default(cuid())
  resourceId   String
  reporterId   String
  reason       ReportReason
  detail       String
  status       ReportStatus @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  reporter   User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User?    @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([resourceId])
  @@map("reports")
}

model ResourceReview {
  id         String   @id @default(cuid())
  resourceId String
  userId     String
  rating     Int?
  content    String
  parentId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  resource Resource         @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   ResourceReview?  @relation("ReviewReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ResourceReview[] @relation("ReviewReplies")

  @@index([resourceId, createdAt])
  @@index([parentId])
  @@map("resource_reviews")
}

// ==========================================
// Phase 1 - Module Code Playground (Issue #36)
// ==========================================

model Language {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  judge0Id       Int      @unique
  monacoLanguage String
  extension      String
  starterCode    String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  snippets CodeSnippet[]
  runLogs  RunLog[]

  @@map("languages")
}

model CodeSnippet {
  id            String     @id @default(cuid())
  title         String
  languageId    String
  code          String
  userId        String
  isPublic      Boolean    @default(false)
  lastRunStatus RunStatus?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  language Language @relation(fields: [languageId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("code_snippets")
}

model RunLog {
  id         String    @id @default(cuid())
  userId     String
  languageId String
  status     RunStatus
  timeMs     Int
  memoryKb   Int
  exitCode   Int       @default(0)
  createdAt  DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("run_logs")
}

// ==========================================
// Courses & AI Learning Path (Sprint Weekly)
// ==========================================

model Course {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  description    String
  instructor     String
  instructorRole String    @default("Giảng viên")
  category       String
  price          Int       @default(0)
  originalPrice  Int       @default(0)
  rating         Float     @default(5.0)
  ratingCount    Int       @default(0)
  students       Int       @default(0)
  hours          Int       @default(0)
  lessonsCount   Int       @default(0)
  labs           Int       @default(0)
  level          String    @default("Cơ bản")
  tags           String[]
  certificate    Boolean   @default(true)
  isPublished    Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sections      Section[]
  enrollments   Enrollment[]
  learningPaths LearningPath[]

  @@map("courses")
}

model Section {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, order])
  @@map("sections")
}

model Lesson {
  id          String   @id @default(cuid())
  sectionId   String
  title       String
  durationMin Int      @default(15)
  free        Boolean  @default(false)
  order       Int      @default(0)
  content     String?
  videoUrl    String?
  createdAt   DateTime @default(now())

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, order])
  @@map("lessons")
}

model Enrollment {
  id                String    @id @default(cuid())
  userId            String
  courseId          String
  progress          Int       @default(0)
  completedLessons  Int       @default(0)
  totalLessons      Int       @default(0)
  certificateIssued Boolean   @default(false)
  enrolledAt        DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@map("enrollments")
}

model SkillProfile {
  id        String   @id @default(cuid())
  userId    String
  topic     String
  accuracy  Int      @default(0)
  answered  Int      @default(0)
  weak      Boolean  @default(false)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
  @@index([userId])
  @@map("skill_profiles")
}

enum MilestoneStatus {
  LOCKED
  IN_PROGRESS
  NEEDS_REVIEW
  COMPLETED
}

model LearningPath {
  id              String   @id @default(cuid())
  userId          String
  courseId        String
  targetGoal      String
  currentLevel    String   @default("TRUNG_BINH")
  hoursPerWeek    Int      @default(6)
  aiSummary       String
  modelName       String   @default("gemini-4-hydrogen-medium")
  progressPercent Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  milestones Milestone[]

  @@index([userId, courseId])
  @@map("learning_paths")
}

model Milestone {
  id             String          @id @default(cuid())
  learningPathId String
  orderIndex     Int
  title          String
  description    String
  estimatedHours Int             @default(5)
  passingScore   Int             @default(70)
  status         MilestoneStatus @default(LOCKED)
  lessonIds      String[]
  quizJson       Json
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  learningPath LearningPath          @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  attempts     MilestoneAttempt[]
  remediations MilestoneRemediation[]

  @@index([learningPathId, orderIndex])
  @@map("milestones")
}

model MilestoneAttempt {
  id            String   @id @default(cuid())
  milestoneId   String
  userId        String
  score         Int
  passed        Boolean
  answersJson   Json
  wrongConcepts String[]
  createdAt     DateTime @default(now())

  milestone    Milestone              @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  remediations MilestoneRemediation[]

  @@index([milestoneId, userId])
  @@map("milestone_attempts")
}

model MilestoneRemediation {
  id                     String   @id @default(cuid())
  milestoneId            String
  attemptId              String?
  weaknessAnalysis       String
  recommendedLessonsJson Json
  remedialQuestionsJson  Json
  resolved               Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  milestone Milestone         @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  attempt   MilestoneAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([milestoneId, resolved])
  @@map("milestone_remediations")
}

model AiUsage {
  id               String   @id @default(cuid())
  userId           String
  feature          String
  modelName        String   @default("gemini-4-hydrogen-medium")
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  latencyMs        Int      @default(0)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, feature])
  @@index([createdAt])
  @@map("ai_usages")
}
