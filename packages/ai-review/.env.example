# Plug-and-play module: @devstudy/ai-review
# Mặc định tắt (false) — khi tắt, core không nạp module và mọi route trả 404.
AI_REVIEW_ENABLED=false

# Bắt buộc chỉ định schema=ai_review và giới hạn connection_limit để không làm gấp đôi pool của core
AI_REVIEW_DATABASE_URL=postgresql://app:app@localhost:5432/itlearn?schema=ai_review&connection_limit=5

# Provider: gemini | fake
AI_REVIEW_LLM_PROVIDER=fake

# Model ID bắt buộc truyền qua env (KHÔNG hard-code trong code).
# Ví dụ: gemini-4-medium hoặc gemini-3.8-flash (hoặc fake-v1 khi provider=fake)
AI_REVIEW_LLM_MODEL=gemini-4-medium

# Bắt buộc khi AI_REVIEW_LLM_PROVIDER=gemini (gửi qua header x-goog-api-key, không qua URL)
AI_REVIEW_LLM_API_KEY=

# Endpoint Gemini REST (mặc định https://generativelanguage.googleapis.com/v1beta)
AI_REVIEW_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_REVIEW_LLM_TIMEOUT_MS=20000
AI_REVIEW_LLM_MAX_OUTPUT_TOKENS=1024
AI_REVIEW_LLM_MAX_RETRIES=1

# Múi giờ reset quota ngày (00:00 giờ Việt Nam)
AI_REVIEW_TIMEZONE=Asia/Ho_Chi_Minh

# Hành vi khi kho đếm quota gặp lỗi: closed (mặc định, tránh đội chi phí LLM) | open
AI_REVIEW_QUOTA_FAIL_MODE=closed

# Bảo mật Phase 3 (tùy chọn — có mặc định an toàn)
# AI_REVIEW_TOKEN_SECRET phải khác JWT_SECRET của core và >= 32 ký tự nếu đặt
# AI_REVIEW_TOKEN_SECRET=
AI_REVIEW_RATE_LIMIT_MAX=30
AI_REVIEW_RATE_LIMIT_WINDOW_SEC=60
