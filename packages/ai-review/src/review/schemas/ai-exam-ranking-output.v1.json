{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-review/exam-ranking-output.v1",
  "title": "AiExamRankingLlmOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["selected_question_ids", "rationale"],
  "properties": {
    "selected_question_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 5,
      "maxLength": 450
    }
  }
}
