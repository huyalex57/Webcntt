{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-review/summary-output.v1",
  "title": "AiReviewSummaryLlmOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "weakness_insights", "study_plan"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 800
    },
    "weakness_insights": {
      "type": "array",
      "minItems": 0,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "diagnosis", "action_step"],
        "properties": {
          "topic": {
            "type": "string",
            "enum": ["CTDL", "OOP", "CSDL", "MANG", "HDH", "AI_DS", "WEB_CLOUD"]
          },
          "diagnosis": {
            "type": "string",
            "minLength": 5,
            "maxLength": 260
          },
          "action_step": {
            "type": "string",
            "minLength": 5,
            "maxLength": 260
          }
        }
      }
    },
    "study_plan": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "title", "focus_topics", "estimated_minutes"],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 140
          },
          "focus_topics": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["CTDL", "OOP", "CSDL", "MANG", "HDH", "AI_DS", "WEB_CLOUD"]
            }
          },
          "roadmap_topic_id": {
            "type": "string",
            "pattern": "^rm:[a-z0-9-]+:[A-Za-z0-9:_-]{1,128}$"
          },
          "reference_url": {
            "type": "string",
            "minLength": 8,
            "maxLength": 512
          },
          "estimated_minutes": {
            "type": "integer",
            "minimum": 10,
            "maximum": 240
          }
        }
      }
    }
  }
}
