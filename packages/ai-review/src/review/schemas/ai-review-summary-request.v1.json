{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-review/summary-request.v1",
  "title": "GenerateAiReviewSummaryRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "topics": {
      "type": "array",
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["CTDL", "OOP", "CSDL", "MANG", "HDH", "AI_DS", "WEB_CLOUD"]
      }
    },
    "roadmap_topic_ids": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^rm:[a-z0-9-]+:[A-Za-z0-9:_-]{1,128}$"
      }
    }
  }
}
